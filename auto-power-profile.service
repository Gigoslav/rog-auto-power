[Unit]
Description=ASUS ROG Auto Power Profile, Refresh Rate Switcher & Live Wattage Tray Indicator
Documentation=https://github.com/Gigoslav/rog-auto-power
PartOf=graphical-session.target
After=graphical-session.target plasma-kscreen.service

[Service]
Type=simple
ExecStart=%h/.local/bin/auto-power-profile.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
